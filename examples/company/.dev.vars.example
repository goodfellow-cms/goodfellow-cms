# What the site reads besides wrangler.jsonc's vars, in `npm run dev` and `npm run preview`. Copy this file to
# .dev.vars, which never leaves this computer. On Cloudflare, set the two secrets with `npx wrangler secret put <NAME>`,
# and the site's address in wrangler.jsonc.

# Signs sessions and their cookies: at least 32 random characters, such as `openssl rand -base64 32` makes.
BETTER_AUTH_SECRET=
# The site's address on this computer, which sign-in trusts requests from.
GOODFELLOW_SITE_URL=http://localhost:4321
# A fine-grained token that can publish to the content repository, and nothing else.
GOODFELLOW_GIT_TOKEN=
# Sends invitations and password resets: the email service (resend, mailgun, sendgrid, ses, or plunk), its key, which
# can only send, and who they're from, on a domain the service has verified. On Cloudflare these come from the code
# repository's variables and secret, as the README's "Email" says. Without them, the editors page shows each
# invitation's link for you to send yourself, and nobody can reset a forgotten password.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
# Only where the service needs them: Mailgun's own domain and region (eu), or Amazon SES's region and access key id.
EMAIL_DOMAIN=
EMAIL_REGION=
EMAIL_KEY_ID=
