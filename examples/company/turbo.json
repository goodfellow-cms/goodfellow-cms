{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      // The Worker vinext builds, and what `goodfellow-next finish --server` writes into public/ before it.
      "outputs": [
        "dist/**",
        ".wrangler/deploy/**",
        "public/api/**",
        "public/pagefind/**",
        "public/calendars/**",
        "public/feeds/**",
        "public/fonts/google/**",
        "public/admin/text/**",
        "public/admin/plugins/**",
        "public/admin/editor/frames/**"
      ]
    },
    "typecheck": {
      // `next typegen` writes the route types in .next/types that the typecheck reads.
      "dependsOn": ["^build"]
    }
  }
}
