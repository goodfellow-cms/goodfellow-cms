{
  "name": "@goodfellow-cms/example-company",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 4321 -H 127.0.0.1",
    "build": "goodfellow-next finish --server && vinext build",
    "preview": "vite preview --port 4321",
    "deploy": "wrangler d1 migrations apply goodfellow-company --remote && vinext-cloudflare deploy --skip-build",
    "migration": "node scripts/new-migration.ts",
    "migrations": "node scripts/emit-migrations.ts",
    "migrate": "node scripts/migrate.ts",
    "typecheck": "next typegen && tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@goodfellow-cms/admin": "workspace:*",
    "@goodfellow-cms/bitbucket": "workspace:*",
    "@goodfellow-cms/blocks": "workspace:*",
    "@goodfellow-cms/core": "workspace:*",
    "@goodfellow-cms/github": "workspace:*",
    "@goodfellow-cms/gitlab": "workspace:*",
    "@goodfellow-cms/next": "workspace:*",
    "@goodfellow-cms/react": "workspace:*",
    "@puckeditor/core": "0.24.0",
    "@vinext/cloudflare": "1.3.3",
    "better-auth": "1.7.18",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.4.0",
    "embla-carousel-react": "8.6.0",
    "kysely": "0.29.8",
    "kysely-d1": "0.4.0",
    "lucide-react": "1.52.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "radix-ui": "1.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.4.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitejs/plugin-rsc": "0.5.39",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "wrangler": "4.156.1"
  }
}
