# What the site's server reads (lib/env.ts) where it isn't on Cloudflare, such as `next start` with Postgres. Copy
# this file to .env.local, which never leaves this computer. With Cloudflare's D1, use .dev.vars (.dev.vars.example).

# Signs sessions and their cookies: at least 32 random characters, such as `openssl rand -base64 32` makes.
BETTER_AUTH_SECRET=
# The site's address, which sign-in trusts requests from.
GOODFELLOW_SITE_URL=http://localhost:4321
# The header your host sets to a visitor's address, which sign-in's limit on tries counts by. Without it, Better Auth
# reads x-forwarded-for. Name only a header the host sets itself, never one visitors can send.
# CLIENT_IP_HEADER=x-real-ip
# A Postgres database, such as Neon's, where there's no D1 database bound as DB.
DATABASE_URL=
# A fine-grained token that can publish to the content repository, and nothing else.
GOODFELLOW_GIT_TOKEN=
# Sends invitations and password resets: a Resend key that can only send (`npx wrangler secret put RESEND_API_KEY` on
# Cloudflare), and who they're from, on a domain Resend has verified. Without them, the editors page shows each
# invitation's link for you to send yourself, and nobody can reset a forgotten password.
RESEND_API_KEY=
EMAIL_FROM=
