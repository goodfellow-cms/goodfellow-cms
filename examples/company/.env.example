# What the site's server reads (lib/env.ts) where it isn't on Cloudflare, such as `next start` with Postgres. Copy
# this file to .env.local, which never leaves this computer. With Cloudflare's D1, use .dev.vars (.dev.vars.example).

# Signs sessions and their cookies: at least 32 random characters, such as `openssl rand -base64 32` makes.
BETTER_AUTH_SECRET=
# The site's address, which sign-in trusts requests from.
GOODFELLOW_SITE_URL=http://localhost:4321
# The header your host sets to a visitor's address, which sign-in's limit on tries counts by. Without it, Better Auth
# reads x-forwarded-for. Name only a header the host sets itself, never one visitors can send.
# CLIENT_IP_HEADER=x-real-ip
# A Postgres database, such as Neon's, where there's no D1 database bound as DB.
DATABASE_URL=
# What the server publishes to the content repository with: the site's publishing app, a GitHub App installed on the
# content repository alone, by its id and private key (the .pem file, with \n for each line break), which Goodfellow's
# setup page makes; or else a fine-grained token that can publish to the content repository, and nothing else.
GOODFELLOW_APP_ID=
GOODFELLOW_APP_KEY=
GOODFELLOW_GIT_TOKEN=
# Sends invitations and password resets: the email service (resend, mailgun, sendgrid, ses, or plunk), its key, which
# can only send, and who they're from, on a domain the service has verified. On Cloudflare these come from the code
# repository's variables and secret, as the README's "Email" says. Without them, the editors page shows each
# invitation's link for you to send yourself, and nobody can reset a forgotten password.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
# Only where the service needs them: Mailgun's own domain and region (eu), or Amazon SES's region and access key id.
EMAIL_DOMAIN=
EMAIL_REGION=
EMAIL_KEY_ID=
# Takes payments through Stripe (README.md's "Payments"): a restricted key with only the permissions that section lists
# (rk_test_… in test mode), and the signing secret of the site's webhook endpoint (whsec_…). On Cloudflare these come
# from the code repository's secrets, as that section says. Without the key, Buy buttons say the site doesn't take
# payments yet. Without the webhook secret, people can still pay, but the webhook answers 503, so the site never
# hears of renewals, cancellations, or refunds: set both.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
