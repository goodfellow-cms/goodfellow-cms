{
  "name": "@goodfellow-cms/react",
  "version": "0.4.0",
  "description": "Renders Goodfellow pages with React.",
  "keywords": [
    "goodfellow",
    "cms",
    "website-builder",
    "puck",
    "react"
  ],
  "homepage": "https://goodfellow-cms.github.io/goodfellow-cms/docs/write-blocks",
  "bugs": "https://github.com/goodfellow-cms/goodfellow-cms/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goodfellow-cms/goodfellow-cms.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-server": "./dist/index.server.js",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./island": {
      "types": "./dist/island.d.ts",
      "import": "./dist/island.js"
    },
    "./hydrate": {
      "types": "./dist/hydrate.d.ts",
      "import": "./dist/hydrate.js"
    },
    "./theme.css": "./theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "theme.css"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@goodfellow-cms/core": "workspace:*",
    "tailwind-merge": "3.7.0"
  },
  "peerDependencies": {
    "@puckeditor/core": "0.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@puckeditor/core": "0.23.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
