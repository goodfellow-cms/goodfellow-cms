{
  "name": "@goodfellow-cms/admin",
  "version": "0.2.0",
  "description": "Goodfellow's admin panel: a visual editor for a site's pages, layout and settings.",
  "keywords": [
    "goodfellow",
    "cms",
    "website-builder",
    "puck",
    "admin-panel",
    "visual-editor"
  ],
  "homepage": "https://goodfellow-cms.github.io/goodfellow-cms/docs/edit-pages",
  "bugs": "https://github.com/goodfellow-cms/goodfellow-cms/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goodfellow-cms/goodfellow-cms.git",
    "directory": "packages/admin"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dev": {
      "types": "./dist/dev.d.ts",
      "import": "./dist/dev.js"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "update-fonts": "node scripts/google-fonts.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.14",
    "@goodfellow-cms/ai": "workspace:*",
    "@goodfellow-cms/core": "workspace:*",
    "@goodfellow-cms/react": "workspace:*",
    "@goodfellow-cms/registry": "workspace:*",
    "codemirror": "6.0.2",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2"
  },
  "peerDependencies": {
    "@puckeditor/core": "0.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@puckeditor/core": "0.23.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/turndown": "5.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
