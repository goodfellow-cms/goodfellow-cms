{
  "name": "goodfellow",
  "version": "0.2.0",
  "description": "Build, develop and preview Goodfellow sites.",
  "keywords": [
    "goodfellow",
    "cms",
    "website-builder",
    "puck",
    "static-site-generator",
    "cli"
  ],
  "homepage": "https://goodfellow-cms.github.io/goodfellow-cms/docs/commands",
  "bugs": "https://github.com/goodfellow-cms/goodfellow-cms/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goodfellow-cms/goodfellow-cms.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "goodfellow": "./bin/goodfellow.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@goodfellow-cms/core": "workspace:*",
    "@tailwindcss/browser": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.3.2"
  },
  "peerDependencies": {
    "@goodfellow-cms/admin": "workspace:*",
    "@goodfellow-cms/react": "workspace:*",
    "@puckeditor/core": "0.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@goodfellow-cms/admin": "workspace:*",
    "@goodfellow-cms/blocks": "workspace:*",
    "@goodfellow-cms/react": "workspace:*",
    "@puckeditor/core": "0.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
