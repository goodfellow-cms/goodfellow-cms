{
  "name": "goodfellow",
  "version": "0.7.0",
  "description": "Build, develop and preview Goodfellow sites.",
  "keywords": [
    "goodfellow",
    "cms",
    "website-builder",
    "puck",
    "static-site-generator",
    "cli"
  ],
  "homepage": "https://goodfellow-cms.github.io/goodfellow-cms/docs/commands",
  "bugs": "https://github.com/goodfellow-cms/goodfellow-cms/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goodfellow-cms/goodfellow-cms.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "goodfellow": "./bin/goodfellow.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@goodfellow-cms/core": "workspace:*",
    "@tailwindcss/browser": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "preact": "11.0.1",
    "preact-render-to-string": "6.8.1",
    "sharp": "0.35.5",
    "vite": "8.3.4"
  },
  "peerDependencies": {
    "@goodfellow-cms/admin": "workspace:*",
    "@goodfellow-cms/react": "workspace:*",
    "@puckeditor/core": "0.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@goodfellow-cms/admin": "workspace:*",
    "@goodfellow-cms/blocks": "workspace:*",
    "@goodfellow-cms/react": "workspace:*",
    "@puckeditor/core": "0.23.0",
    "@types/react": "^19.2.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.52.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
