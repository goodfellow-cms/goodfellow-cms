{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Web Request and Response, which every server runtime has, and no Node: so nothing here can use node: modules,
    // Buffer or process, which Cloudflare Workers may not have.
    "lib": ["ES2023", "DOM"],
    "types": []
  },
  "include": ["src/server.ts", "src/server-*.ts", "src/globals.d.ts"],
  "exclude": ["src/**/*.test.ts"]
}
