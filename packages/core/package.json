{
  "name": "@goodfellow-cms/core",
  "version": "0.8.0",
  "description": "Goodfellow CMS's content model, config and file format. Runs in Node and the browser.",
  "keywords": [
    "goodfellow",
    "cms",
    "website-builder",
    "puck"
  ],
  "homepage": "https://goodfellow-cms.github.io/goodfellow-cms/docs/content-files",
  "bugs": "https://github.com/goodfellow-cms/goodfellow-cms/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goodfellow-cms/goodfellow-cms.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./wordpress": {
      "types": "./dist/wordpress.d.ts",
      "import": "./dist/wordpress.js"
    },
    "./content-api": {
      "types": "./dist/content-api.d.ts",
      "import": "./dist/content-api.js"
    },
    "./search-index": {
      "types": "./dist/node-search.d.ts",
      "import": "./dist/node-search.js"
    },
    "./accessibility": {
      "types": "./dist/node-accessibility.d.ts",
      "import": "./dist/node-accessibility.js"
    },
    "./shadcn": {
      "types": "./dist/node-shadcn.d.ts",
      "import": "./dist/node-shadcn.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "goodfellow-early": "./bin/goodfellow-early.js",
    "goodfellow-task": "./bin/goodfellow-task.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run"
  },
  "dependencies": {
    "axe-core": "4.14.0",
    "domhandler": "6.0.1",
    "fontaine": "1.0.0",
    "happy-dom": "21.0.4",
    "htmlparser2": "12.0.0",
    "ical.js": "2.2.1",
    "marked": "18.1.0",
    "pagefind": "1.5.2",
    "sigstore": "5.0.0",
    "xss": "1.0.15",
    "yaml": "2.9.1",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@puckeditor/core": "0.23.0"
  },
  "devDependencies": {
    "@puckeditor/core": "0.23.0",
    "@types/node": "^22.19.0",
    "react": "19.3.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
