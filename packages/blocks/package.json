{
  "name": "@goodfellow-cms/blocks",
  "version": "0.8.0",
  "description": "Goodfellow CMS's built-in blocks. Styled with Tailwind and the site theme only.",
  "keywords": [
    "goodfellow",
    "cms",
    "website-builder",
    "puck",
    "blocks",
    "tailwind"
  ],
  "homepage": "https://goodfellow-cms.github.io/goodfellow-cms/docs/built-in-blocks",
  "bugs": "https://github.com/goodfellow-cms/goodfellow-cms/issues",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/goodfellow-cms"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goodfellow-cms/goodfellow-cms.git",
    "directory": "packages/blocks"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "react-native": "./dist/native.js",
      "import": "./dist/native.js",
      "default": "./dist/native.js"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "update-icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@goodfellow-cms/core": "workspace:*",
    "@goodfellow-cms/react": "workspace:*",
    "shiki": "4.5.0"
  },
  "peerDependencies": {
    "@goodfellow-cms/expo": "workspace:*",
    "@puckeditor/core": "0.23.0",
    "react": "^19.0.0",
    "react-native": "*"
  },
  "devDependencies": {
    "@goodfellow-cms/expo": "workspace:*",
    "@puckeditor/core": "0.23.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-web": "0.21.4",
    "react-native-webview": "14.0.1"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@goodfellow-cms/expo": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  }
}
