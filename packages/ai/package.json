{
  "name": "@goodfellow-cms/ai",
  "version": "0.4.0",
  "description": "Goodfellow's AI assistant: drafts and rewrites pages with Claude, OpenAI or a free AI service, straight from the browser.",
  "keywords": [
    "goodfellow",
    "cms",
    "website-builder",
    "puck",
    "ai",
    "claude",
    "openai"
  ],
  "homepage": "https://goodfellow-cms.github.io/goodfellow-cms/docs/ai-assistant",
  "bugs": "https://github.com/goodfellow-cms/goodfellow-cms/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goodfellow-cms/goodfellow-cms.git",
    "directory": "packages/ai"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@goodfellow-cms/core": "workspace:*"
  },
  "peerDependencies": {
    "@puckeditor/core": "0.23.0"
  },
  "devDependencies": {
    "@goodfellow-cms/blocks": "workspace:*",
    "@goodfellow-cms/react": "workspace:*",
    "@puckeditor/core": "0.23.0",
    "@types/react": "^19.2.0",
    "react": "19.3.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
