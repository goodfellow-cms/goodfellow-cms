{
  "name": "@goodfellow-cms/worker",
  "version": "0.2.0",
  "private": true,
  "description": "Goodfellow's sign-in worker: editors sign in with GitHub, and the admin panel gets a token for one repository, lasting an hour.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "npx wrangler@4 dev",
    "deploy": "npx wrangler@4 deploy"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@goodfellow-cms/core": "workspace:*",
    "@goodfellow-cms/github": "workspace:*"
  }
}
