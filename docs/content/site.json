{
  "version": 1,
  "description": "A website builder for people who aren't developers, with no server or database: pages are files in your own GitHub or GitLab repository.",
  "externalLinksInNewTab": true,
  "favicon": "/media/favicon.svg",
  "language": "en",
  "logo": {
    "alt": "Goodfellow",
    "darkSrc": "/media/logo-dark.svg",
    "src": "/media/logo.svg"
  },
  "theme": {
    "colors": {
      "accent": "#f5ece2",
      "border": "#e7e5e4",
      "muted": "#f5ece2",
      "mutedForeground": "#57534e",
      "primary": "#153823",
      "primaryForeground": "#ffffff",
      "secondary": "#f5ece2"
    },
    "darkColors": {
      "accent": "#26221e",
      "accentForeground": "#f5ece2",
      "background": "#141210",
      "border": "#3a3430",
      "foreground": "#f5ece2",
      "muted": "#26221e",
      "mutedForeground": "#a8a29e",
      "primary": "#d08048",
      "primaryForeground": "#141210",
      "secondary": "#26221e",
      "secondaryForeground": "#f5ece2"
    },
    "darkMode": true,
    "fonts": {
      "body": "Inter",
      "heading": "Fraunces"
    }
  },
  "title": "Goodfellow",
  "titleTemplate": "%s | Goodfellow",
  "url": "https://goodfellow-cms.github.io/goodfellow-cms"
