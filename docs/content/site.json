{
  "version": 1,
  "description": "A website builder for people who aren't developers, with no server or database: pages are files in your own GitHub, GitLab or Bitbucket repository.",
  "externalLinksInNewTab": true,
  "favicon": "/media/favicon.svg",
  "language": "en",
  "logo": {
    "alt": "Goodfellow",
    "darkSrc": "/media/logo-dark.svg",
    "src": "/media/logo.svg"
  },
  "socialImage": "/media/social.png",
  "theme": {
    "code": {
      "background": "site",
      "dark": "everforest-dark",
      "light": "everforest-light"
    },
    "colors": {
      "accent": "#f5ece2",
      "border": "#e7e5e4",
      "muted": "#f5ece2",
      "mutedForeground": "#57534e",
      "primary": "#153823",
      "primaryForeground": "#ffffff",
      "secondary": "#f5ece2"
    },
    "darkColors": {
      "accent": "#18241d",
      "accentForeground": "#f5ece2",
      "background": "#0f1813",
      "border": "#2a3a31",
      "foreground": "#f5ece2",
      "muted": "#18241d",
      "mutedForeground": "#a0ada4",
      "primary": "#9cc9a7",
      "primaryForeground": "#0f1813",
      "secondary": "#18241d",
      "secondaryForeground": "#f5ece2"
    },
    "darkMode": true,
    "fonts": {
      "body": "Inter",
      "bodyCategory": "sans-serif",
      "heading": "Fraunces",
      "headingCategory": "serif"
    },
    "parts": {
      "gf-donate-button": "h-9 px-4 text-sm"
    }
  },
  "title": "Goodfellow CMS",
  "titleTemplate": "%s | Goodfellow CMS",
  "url": "https://goodfellow-cms.github.io/goodfellow-cms"
}
